---
// Quello che in Next stava in pages/_document.js e pages/_app.js: head, GTM, Iubenda, CSS globale.
import "../../styles/globals.css";
// CSS dei caroselli Splide qui e non nei componenti: caricati a richiesta, il loro CSS arriverebbe dopo l'HTML.
import "@splidejs/splide/css/core";
import MetaTags from "components/layout/MetaTags";
import t from "lib/locales";
import { draft } from "lib/dato";

const { locale, site, page, noindex = false } = Astro.props;
const GTM_ID = process.env.NEXT_PUBLIC_GTM_2;
const IUBENDA_SITE_ID = process.env.NEXT_PUBLIC_IUBENDA_SITE_ID;
const isStaging = process.env.NEXT_PUBLIC_ENV === "staging";

const iubendaConfig = `
var _iub = _iub || [];
_iub.csConfiguration = {
  "askConsentAtCookiePolicyUpdate":true,
  "countryDetection":true,
  "enableUspr":true,
  "enableLgpd":true,
  "lang":"${locale}",
  "perPurposeConsent":true,
  "siteId":${IUBENDA_SITE_ID},
  "cookiePolicyId":"${t("cookiePolicyId", locale)}",
  purposes: "1, 3, 4",
  "banner":{
    "acceptButtonColor":"#4637F1",
    "acceptButtonDisplay":true,
    "backgroundColor":"#EBEBEB",
    "brandBackgroundColor":"#EBEBEB",
    "closeButtonRejects":true,
    "customizeButtonColor":"#4637F1",
    "customizeButtonDisplay":true,
    "brandTextColor":"#000000",
    "logo":"https://www.cantierecreativo.net/logos/color.svg",
    "position":"float-bottom-center",
    "rejectButtonColor":"#4637F1",
    "rejectButtonDisplay":true,
    "explicitWithdrawal":true,
    "listPurposes":true,
    "slideDown":false,
    "linksColor":"#000000",
    "showPurposesToggles":true,
    "textColor":"#000000"
  }
}`;
const iubendaLoader = `(function (w,d) {var loader = function () {var s = d.createElement("script"), tag = d.getElementsByTagName("script")[0]; s.src="https://cdn.iubenda.com/iubenda.js"; tag.parentNode.insertBefore(s,tag);}; if(w.addEventListener){w.addEventListener("load", loader, false);}else if(w.attachEvent){w.attachEvent("onload", loader);}else{w.onload = loader;}})(window, document);`;
const gtm = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-${GTM_ID}');`;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {/* I due font del sito servono già nella prima schermata: si scaricano subito, senza aspettare il CSS. */}
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/basicSans.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preconnect" href="https://www.datocms-assets.com" />
    <link rel="preconnect" href="https://cdn.iubenda.com" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {page && <MetaTags site={site} page={page} locale={locale} />}
    {(noindex || draft) && <meta name="robots" content="noindex" />}
    {
      IUBENDA_SITE_ID && !isStaging && (
        <>
          <script is:inline set:html={iubendaConfig} />
          <script is:inline async src="//cdn.iubenda.com/cs/iubenda_cs.js" />
          <script is:inline set:html={iubendaLoader} />
        </>
      )
    }
    <script is:inline async src="https://s.widgetwhats.com/wwwa.js" data-wwwa="24811"></script>
    {
      !isStaging && GTM_ID && (
        <script
          is:inline
          type="text/plain"
          class="_iub_cs_activate"
          id="google-tag-manager"
          data-iub-purposes="4"
          set:html={gtm}
        />
      )
    }
  </head>
  <body>
    {
      !isStaging && GTM_ID && (
        <noscript type="text/plain" class="_iub_cs_activate" data-iub-purposes="4">
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=GTM-${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <slot />
  </body>
</html>
