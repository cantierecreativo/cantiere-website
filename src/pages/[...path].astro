---
// Tutte le pagine del sito. Ogni vista in views/ porta i suoi getStaticPaths/getStaticProps
// scritti per Next: qui si chiamano per entrambe le lingue e si rende la vista come isola React.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageView, { views } from "../PageView.jsx";
import { blocks } from "components/PostContent";
import { pathFor, isDynamic, matchPath } from "../routes.mjs";
import { draft } from "lib/dato";

export async function getStaticPaths() {
  // Astro esegue getStaticPaths isolata dal resto del file: le costanti stanno qui dentro.
  const LOCALES = ["it", "en"];
  const NOT_PAGES = ["404"];
  const modules = import.meta.glob("../../views/**/*.jsx", { eager: true });
  const byPath = new Map();
  for (const [file, mod] of Object.entries(modules)) {
    const view = file.replace("../../views/", "").replace(/\.jsx$/, "");
    if (NOT_PAGES.includes(view)) continue;
    const entries = mod.getStaticPaths
      ? (await mod.getStaticPaths({ locales: LOCALES })).paths
      : LOCALES.map((locale) => ({ params: {}, locale }));
    for (const { params, locale } of entries) {
      const path = pathFor(view, locale, params);
      const taken = byPath.get(path);
      if (taken && !isDynamic(taken.props.view)) continue;
      byPath.set(path, { params: { path: path.slice(1) || undefined }, props: { view, locale, params, path } });
    }
  }
  return [...byPath.values()];
}

const loaders = import.meta.glob("../../views/**/*.jsx");
// Build statica: la pagina arriva da getStaticPaths. Preview (DATOCMS_DRAFT, rendering a richiesta):
// la vista si ricava dall'URL e i dati si leggono da Dato a ogni richiesta, bozze comprese.
const path = Astro.props.path ?? "/" + (Astro.params.path ?? "");
const match = Astro.props.view
  ? Astro.props
  : matchPath(path, Object.keys(loaders).map((f) => f.replace("../../views/", "").replace(/\.jsx$/, "")).filter((v) => v !== "404"));
const notFoundPage = path.startsWith("/en/") || path === "/en" ? "/en/404" : "/404";
if (!match) return Astro.rewrite(notFoundPage);
const { view, locale, params } = match;
const { props, notFound } = await (await loaders[`../../views/${view}.jsx`]()).getStaticProps({ params, locale, preview: draft });
if (notFound) return draft ? Astro.rewrite(notFoundPage) : new Response(null, { status: 404 });
if (draft) Astro.response.headers.set("Cache-Control", "no-store");
// Sul server vista e blocchi devono essere già caricati prima del render (vedi src/parts.jsx).
await Promise.all([views.preload([`../views/${view}.jsx`]), blocks.preload()]);
---

<BaseLayout locale={locale} site={props.site} page={props.page} noindex={view.startsWith("blog/tags/")}>
  <PageView client:idle view={view} locale={locale} path={path} props={props} />
</BaseLayout>
