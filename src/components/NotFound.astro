---
// Pagina 404 nella lingua richiesta; Netlify la serve da /404 e /en/404 (vedi public/_redirects).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageView from "../PageView.jsx";
import { getStaticProps } from "views/404";

const { locale } = Astro.props;
const { props } = await getStaticProps({ locale });
---

<BaseLayout locale={locale} site={props.site} noindex>
  <PageView client:load view="404" locale={locale} path={locale === "it" ? "/404" : "/en/404"} props={props} />
</BaseLayout>
