# Lette solo in build (lato server): non arrivano al browser.
NEXT_PUBLIC_DATO_API_KEY=        # token read-only della CDA DatoCMS (nome storico, è server-side)
NEXT_PUBLIC_DATO_ENV=            # environment Dato, vuoto = primary
DATOCMS_PREVIEW_TOKEN=           # solo per il deploy di preview
DATOCMS_DRAFT=                   # "true" nel deploy di preview: build con le bozze
DATOCMS_CMA_TOKEN=               # solo per scripts/i18n, mai su Netlify in produzione
ANTHROPIC_API_KEY=               # solo per scripts/i18n

# Pubbliche: finiscono nel browser (PUBLIC_ENV in astro.config.mjs).
NEXT_PUBLIC_SITE_URL=https://www.cantierecreativo.net
NEXT_PUBLIC_ENV=production       # "staging" disattiva GTM e Iubenda
NEXT_PUBLIC_GTM_2=
NEXT_PUBLIC_IUBENDA_SITE_ID=
